#pragma kernel BuildGrass

#include "GrassHash.hlsl"
#include "Assets/Shaders/GrassStructs.hlsl"

StructuredBuffer<TileData> _VisibleTiles;
AppendStructuredBuffer<GrassData> _GrassDataBuffer;

float _TileSize;
uint _GrassPerAxis;

// Baseline blade shape, each blade below is randomized around these values.
float _BaseHeight;
float _BaseWidth;
float _BaseBend;
float _BaseTilt;

// How much each per-blade property is allowed to deviate from its base value.
float _ShapeVariance;    // fraction of base height/width/bend/tilt, e.g. 0.3 = +/-30%
float _SideCurveStrength; // max magnitude of the random sideways curve
float _JitterStrength;    // fraction of the grid step used as position jitter, 0-1

// 8x8 threads per group (64 blades evaluated per group)
[numthreads(8, 8, 1)]
void BuildGrass (uint3 id : SV_DispatchThreadID, uint3 groupID : SV_GroupID)
{
    // groupID.z indexes into the current visible-tiles list, which is rebuilt every frame as the camera moves.
    TileData tile = _VisibleTiles[groupID.z];

    // Ensure it don't process out-of-bounds threads if _GrassPerAxis isn't a multiple of 8
    if (id.x >= _GrassPerAxis || id.y >= _GrassPerAxis)
        return;

    // Calculate local position inside the tile
    float step = _TileSize / (float)_GrassPerAxis;
    float halfSize = _TileSize * 0.5f;

    // Combine the tile's stable grid id with the grid cell into one per-blade hash.
    // Every random draw below is seeded from this single value, so it stays
    // identical for a given blade across frames/dispatches.
    uint rawIndex = tile.tileId * 92821u + id.x * 15761u + id.y * 60013u;
    uint bladeHash = HashUInt(rawIndex);

    // Jitter the grid position within its cell so blades don't sit on a perfect grid.
    float jitterX = HashToSigned(bladeHash, 0) * step * 0.5 * _JitterStrength;
    float jitterZ = HashToSigned(bladeHash, 1) * step * 0.5 * _JitterStrength;

    float3 localPos = float3(id.x * step - halfSize + jitterX, 0, id.y * step - halfSize + jitterZ);
    float3 worldPos = tile.center + localPos;

    // Random facing direction (normalized 2D vector in the world XZ plane)
    float facingAngle = HashToFloat01(bladeHash, 2) * 6.28318530718; // 2*PI
    float2 facing = float2(cos(facingAngle), sin(facingAngle));

    // Per-blade shape variation around the base params
    float height = max(0.01, _BaseHeight * (1.0 + HashToSigned(bladeHash, 3) * _ShapeVariance));
    float width = max(0.001, _BaseWidth * (1.0 + HashToSigned(bladeHash, 4) * _ShapeVariance));
    float tilt = _BaseTilt * (1.0 + HashToSigned(bladeHash, 5) * _ShapeVariance);
    float bend = _BaseBend * (1.0 + HashToSigned(bladeHash, 6) * _ShapeVariance);
    float sideCurve = HashToSigned(bladeHash, 7) * _SideCurveStrength;

    // Placeholders until the Voronoi clump system assigns real per-clump
    // values and the wind system drives per-blade wind response.
    float clumpFacingAngle = HashToFloat01(bladeHash, 8) * 6.28318530718;
    float2 clumpFacing = float2(cos(clumpFacingAngle), sin(clumpFacingAngle));
    float3 clumpColor = float3(HashToFloat01(bladeHash, 9), HashToFloat01(bladeHash, 10), HashToFloat01(bladeHash, 11));
    float windStrength = HashToFloat01(bladeHash, 12);

    // Output surviving grass to the Append Buffer
    GrassData grass;
    grass.position = worldPos;
    grass.facing = facing;
    grass.height = height;
    grass.width = width;
    grass.tilt = tilt;
    grass.bend = bend;
    grass.sideCurve = sideCurve;
    grass.clumpFacing = clumpFacing;
    grass.clumpColor = clumpColor;
    grass.windStrength = windStrength;
    grass.bladeHash = bladeHash;

    _GrassDataBuffer.Append(grass);
}
