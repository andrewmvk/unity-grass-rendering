#pragma kernel BuildGrass

#include "GrassHash.hlsl"
#include "Assets/Shaders/GrassStructs.hlsl"
#include "Assets/Shaders/GrassTerrainSampling.hlsl"

StructuredBuffer<TileData> _VisibleTiles;
AppendStructuredBuffer<GrassData> _GrassDataBuffer;
AppendStructuredBuffer<GrassData> _GrassDataBufferLow;

float _TileSize;
uint _GrassPerAxis;
float _GrassLODSwitchDist;

// Fine per-blade culling: the CPU pass already discards whole tiles outside the
// frustum, but a partially-overlapping tile can still have blades beyond its edge.
float4 _FrustumPlanes[6];

// Worst-case distance from a blade's root to any of its vertices, computed on the CPU
// from the current shape params (see GrassManager.ComputeBladeBoundingRadius). Treating
// the root as a sphere of this radius avoids culling a blade whose tip still leans into view.
float _BladeBoundingRadius;

// Ground-validity mask: the terrain's painted layer-0 alphamap. >0.5 means grass is allowed to grow there.
Texture2D<float4> _ControlTexture;

// Blades already faded to nothing are skipped
float _GrassFadeStartDist;
float _GrassFadeEndDist;
float3 _GrassCameraPosition;

float _GrassDensityFadeStartDist;
float _GrassDensityFadeEndDist;
float _GrassMinDensityFraction;

bool IsInsideFrustum(float3 worldPos, float radius)
{
    for (int i = 0; i < 6; i++)
    {
        float4 plane = _FrustumPlanes[i];
        if (dot(plane.xyz, worldPos) + plane.w < -radius)
            return false;
    }
    return true;
}

bool IsValidGround(float3 worldPos)
{
    float2 local = worldPos.xz - _TerrainOriginXZ;
    if (any(local < 0) || any(local > _TerrainSize))
        return false; // outside the terrain's footprint entirely

    float2 uv = local / _TerrainSize;
    uint texWidth, texHeight;
    _ControlTexture.GetDimensions(texWidth, texHeight);
    uint2 texel = uint2(uv * float2(texWidth - 1, texHeight - 1));

    return _ControlTexture.Load(int3(texel, 0)).r > 0.5;
}

// Baseline blade shape, each blade below is randomized around these values.
float _BaseHeight;
float _BaseWidth;
float _BaseBend;
float _BaseTilt;

// How much each per-blade property is allowed to deviate from its base value.
float _ShapeVariance;    // fraction of base height/width/bend/tilt, e.g. 0.3 = +/-30%
float _SideCurveStrength; // max magnitude of the random sideways curve
float _JitterStrength;    // fraction of the grid step used as position jitter, 0-1

// How strongly a blade's facing is pulled toward downhill as slope steepens:
// 0 = always random, 1 = fully downhill on any non-flat ground.
float _SlopeLeanStrength;

// 8x8 threads per group (64 blades evaluated per group)
[numthreads(8, 8, 1)]
void BuildGrass (uint3 id : SV_DispatchThreadID, uint3 groupID : SV_GroupID)
{
    // groupID.z indexes into the current visible-tiles list, which is rebuilt every frame as the camera moves.
    TileData tile = _VisibleTiles[groupID.z];

    // Skip threads outside _GrassPerAxis, in case it isn't a multiple of 8.
    if (id.x >= _GrassPerAxis || id.y >= _GrassPerAxis)
        return;

    float step = _TileSize / (float)_GrassPerAxis;
    float halfSize = _TileSize * 0.5f;

    // Combines the tile's stable id with the grid cell into one per-blade hash. Every
    // random draw below is seeded from this value, so it stays stable across frames.
    uint rawIndex = tile.tileId * 92821u + id.x * 15761u + id.y * 60013u;
    uint bladeHash = HashUInt(rawIndex);

    // Jitters the grid position within its cell so blades don't sit on a perfect grid.
    float jitterX = HashToSigned(bladeHash, 0) * step * 0.5 * _JitterStrength;
    float jitterZ = HashToSigned(bladeHash, 1) * step * 0.5 * _JitterStrength;

    float3 localPos = float3(id.x * step - halfSize + jitterX, 0, id.y * step - halfSize + jitterZ);
    float3 worldPos = tile.center + localPos;

    worldPos.y = SampleTerrainHeight(worldPos.xz);

    // Fine culling: skip this thread entirely if the blade's bounding sphere falls
    // outside the frustum, or its root sits off valid ground.
    if (!IsInsideFrustum(worldPos, _BladeBoundingRadius) || !IsValidGround(worldPos))
        return;

    // Skip blades already faded to nothing by distance.
    if (GetGrassFadeShrink(worldPos, _GrassCameraPosition, _GrassFadeStartDist, _GrassFadeEndDist) <= 0.0)
        return;

    float distToCamera = length(worldPos - _GrassCameraPosition);
    float densityKeepFraction = lerp(1.0, _GrassMinDensityFraction, smoothstep(_GrassDensityFadeStartDist, _GrassDensityFadeEndDist, distToCamera));
    if (HashToFloat01(bladeHash, 10) >= densityKeepFraction)
        return;

    // Random facing direction, as a unit vector in the world XZ plane.
    float facingAngle = HashToFloat01(bladeHash, 2) * 6.28318530718; // 2*PI
    float2 randomFacing = float2(cos(facingAngle), sin(facingAngle));

    // Ground normal, sampled once per blade (not per vertex, see GrassVertex.hlsl). Its
    // horizontal part already points downhill, so it doubles as the downhill direction.
    float3 groundNormal = ComputeTerrainNormal(worldPos.xz);
    float2 downhill = groundNormal.xz;
    float slope = saturate(length(downhill)); // ~0 flat, approaches 1 as slope steepens

    // Rotates downhill by -90 degrees so ApplyBladeOrientation's forward axis (90 degrees
    // CCW from facing) points downhill, letting the blade's tilt/bend lean that way on slopes.
    float2 downhillLeanFacing = slope > 1e-5 ? float2(downhill.y, -downhill.x) / slope : randomFacing;
    float2 facing = normalize(lerp(randomFacing, downhillLeanFacing, slope * _SlopeLeanStrength));

    float height = max(0.01, _BaseHeight * (1.0 + HashToSigned(bladeHash, 3) * _ShapeVariance));
    float width = max(0.001, _BaseWidth * (1.0 + HashToSigned(bladeHash, 4) * _ShapeVariance));
    float tilt = _BaseTilt * (1.0 + HashToSigned(bladeHash, 5) * _ShapeVariance);
    float bend = _BaseBend * (1.0 + HashToSigned(bladeHash, 6) * _ShapeVariance);
    float sideCurve = HashToSigned(bladeHash, 7) * _SideCurveStrength;

    // Placeholder until the Voronoi clump system assigns a real per-clump
    // facing, and the wind system drives per-blade wind response.
    float clumpFacingAngle = HashToFloat01(bladeHash, 8) * 6.28318530718;
    float2 clumpFacing = float2(cos(clumpFacingAngle), sin(clumpFacingAngle));
    float windStrength = HashToFloat01(bladeHash, 9);

    GrassData grass;
    grass.position = worldPos;
    grass.facing = facing;
    grass.height = height;
    grass.width = width;
    grass.tilt = tilt;
    grass.bend = bend;
    grass.sideCurve = sideCurve;
    grass.clumpFacing = clumpFacing;
    grass.windStrength = windStrength;
    grass.bladeHash = bladeHash;

    if (distToCamera >= _GrassLODSwitchDist)
        _GrassDataBufferLow.Append(grass);
    else
        _GrassDataBuffer.Append(grass);
}
